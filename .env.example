VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_SITE_URL=https://your-deployment.vercel.app
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
# Server-only Supabase secrets (set with `supabase secrets set`, NEVER add to VITE_ variables):
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
# VAPID_KEYS_JSON
# VAPID_SUBJECT=mailto:admin@yourdomain.example
# SITE_URL=https://your-deployment.vercel.app
